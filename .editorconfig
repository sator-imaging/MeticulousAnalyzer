[*.cs]
##dotnet_diagnostic.SMA8000.severity = silent

# Read-Only Variable Analysis
dotnet_analyzer_diagnostic.category-ImmutableVariable.severity = silent
dotnet_diagnostic.SMA0060.severity = error
dotnet_diagnostic.SMA0061.severity = error
dotnet_diagnostic.SMA0062.severity = error
dotnet_diagnostic.SMA0063.severity = error
dotnet_diagnostic.SMA0064.severity = error
dotnet_diagnostic.SMA0065.severity = error
dotnet_diagnostic.SMA0066.severity = error
dotnet_diagnostic.SMA0067.severity = error
dotnet_diagnostic.SMA0068.severity = error
dotnet_diagnostic.SMA0069.severity = error

dotnet_diagnostic.SMA0080.severity = silent # Internal types and members must not be accessed from a different namespace
dotnet_diagnostic.SMA7001.severity = silent # Implicit delegate conversion
dotnet_diagnostic.SMA7030.severity = silent # Implicit `params` array allocation

dotnet_diagnostic.CS1591.severity = silent  # Missing XML comment for publicly visible type or member
