<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The published analyzer has the same assembly identity as the local projects -->
    <PackageReference Remove="SatorImaging.MeticulousAnalyzer" />

    <ProjectReference Include="../src/analysis/SatorImaging.MeticulousAnalyzer.Analysis.csproj">
		  <OutputItemType>Analyzer</OutputItemType>
		  <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
	  </ProjectReference>

  </ItemGroup>

</Project>
